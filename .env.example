BREVO_USER=yourdetails@smtp-brevo.com
BREVO_KEY=Your-brevo-key
BREVO_FROM=noreply@yourdomain.com
ADMIN_USERNAME=Admin-username
ADMIN_PASSWORD=admin-password
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/oauth/callback
SUPPORT_SESSION_SECRET=support-session-key
SUPPORT_URL=https://support.yourdomain.com
APP_URL=https://yourdomain.com
# SMS delivery for two-factor codes: textbelt | email-gateway | log (default)
SMS_PROVIDER=log
# Textbelt key ('textbelt' = 1 free text/day per IP, see https://textbelt.com)
SMS_TEXTBELT_KEY=textbelt
# Default email-to-SMS gateway for SMS_PROVIDER=email-gateway (e.g. vtext.com, txt.att.net)
SMS_GATEWAY=vtext.com
# Per-carrier gateway routing (carrier=domain,carrier=domain) — matched against
# the user's carrier profile field; unknown carriers fall back to SMS_GATEWAY.
# NOTE: many carriers have discontinued email-to-SMS (AT&T 2025, T-Mobile,
# Verizon flagged) — verify a domain still works before relying on it.
CARRIER_GATEWAYS=verizon=vtext.com,mtn=sms.mtn.co.za,vodacom=voda.co.za,bell=txt.bell.ca,telus=msg.telus.com